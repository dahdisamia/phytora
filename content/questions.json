      { "id": "dmg_holes_fruit", "labelAr": "ثقوب في الثمار", "labelFr": "Trous dans les fruits", "descriptionAr": "قد يصاحبها نشارة أو إفرازات", "descriptionFr": "Parfois avec sciure ou sécrétions" },
      { "id": "dmg_holes_leaves", "labelAr": "ثقوب أو قضم في الأوراق", "labelFr": "Trous ou morsures sur les feuilles", "descriptionFr": "Bords rongés ou feuilles perforées" },
