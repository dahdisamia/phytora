      { "id": "dmg_lesions", "labelAr": "بقع أو تقرحات على الأوراق", "labelFr": "Taches ou lésions sur les feuilles", "descriptionAr": "قد تكون بنية أو مائية", "descriptionFr": "Brunes ou aqueuses" },
      { "id": "dmg_scale", "labelAr": "قشور أو دروع ملتصقة", "labelFr": "Écailles ou boucliers fixés", "descriptionAr": "على السعف أو الثمار", "descriptionFr": "Sur les palmes ou les fruits" },
